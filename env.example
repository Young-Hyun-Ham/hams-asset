
GEMINI_API_KEY="xxxxx"
# Turso/libSQL
TURSO_DATABASE_URL=libsql://hamsasset-hamsfam.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=xxxxx

# 이 애플리케이션의 외부 기준 URL
NEXT_PUBLIC_APP_URL=http://localhost:3013

# HAMS SSO 서버
HAMS_OAUTH_SERVER_URL=http://localhost:3000
HAMS_OAUTH_CLIENT_ID=hams-asset
HAMS_OAUTH_CLIENT_SECRET=xxxxx

# 서비스마다 별도로 생성한 서버 전용 난수
HAMS_COOKIE_PREFIX=hams_asset
HAMS_SESSION_SECRET=xxxxx

# 자산 JSON의 레코드별 secret을 감싸는 전용 마스터 키입니다.
# 운영에서는 HAMS_SESSION_SECRET과 다른 32바이트 이상의 랜덤 값을 사용하세요.
HAMS_ASSET_ENCRYPTION_KEY=xxxxx

# 선택 사항. 유효한 양의 정수가 아니면 기본값 604800(7일)을 사용한다.
HAMS_SSO_SESSION_MAX_AGE_SEC=604800

# 임시 로그인 mock data 사용 허용
NEXT_PUBLIC_DEV_MOCK_LOGIN=false
HAMS_SSO_DEV_MOCK_USER_ID=xxxxx-xxxxx-xxxxx-xxxxxx
HAMS_SSO_DEV_MOCK_USER_EMAIL=hyh8414@gmail.com
HAMS_SSO_DEV_MOCK_USER_LOGIN_ID=hyh8414
HAMS_SSO_DEV_MOCK_USER_NAME=함영현

HAMS_ADMIN_ACCOUNT=['hyh8414@gmail.com']
